<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Shell" CornerRadius="22" BorderThickness="0" SnapsToDevicePixels="True" UseLayoutRounding="True" Padding="20,15,20,14">
 <Border.Resources>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate><Border Background="#50919CAB" CornerRadius="3" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
  <SolidColorBrush x:Key="Ink" Color="#242832"/>
  <SolidColorBrush x:Key="Muted" Color="#747986"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#3478F6"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#DEE9FF"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#B8FFFFFF"/>
  <SolidColorBrush x:Key="LineBrush" Color="#23748195"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style TargetType="Button"><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#7194E9"/><Setter TargetName="b" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="Margin" Value="0,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><DockPanel><Border x:Name="track" DockPanel.Dock="Right" Width="30" Height="18" CornerRadius="9" Background="#CCD0D7"><Ellipse x:Name="thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2"/></Border><ContentPresenter VerticalAlignment="Center"/></DockPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="#243F76"/><Setter TargetName="track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#96FFFFFF"/><Setter Property="BorderBrush" Value="#C6D2D8E3"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource PanelBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Padding="10,8"><Path Data="M0 0 L4 4 L8 0" Stroke="#8892A2" StrokeThickness="1.3" HorizontalAlignment="Right"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="11,7,28,7" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#F3F5F8" CornerRadius="9" Padding="5" MinWidth="200" BorderBrush="#D5DCE6" BorderThickness="1"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Height" Value="24"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="3" Background="#D4DAE3" CornerRadius="2"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="3" Background="{DynamicResource AccentBrush}" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate><Ellipse Fill="#FFFFFF" Stroke="#C2CDDC" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Border.Resources>
 <StackPanel>
  <Grid x:Name="Header" Margin="0,0,0,13" Background="Transparent">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandLogo" Width="30" Height="30" Margin="-6,0,3,0" Stretch="Uniform"/><TextBlock Text="LINGUA" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="Mode" Text=" /  划词即译" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></StackPanel>
   <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Right"/>
  </Grid>
  <ScrollViewer x:Name="Viewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
   <StackPanel>
    <StackPanel x:Name="Reading">
     <Border x:Name="ThemeBanner" Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="12,0,3,0" Margin="0,0,0,12" Visibility="Collapsed"><Grid Height="70"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ThemeName" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="ThemeSubtitle" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><Image x:Name="ThemeArt" Grid.Column="1" Width="150" Height="68" Stretch="Uniform"/></Grid></Border>
     <Grid x:Name="OriginalSection" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Original" Text="划词，即刻理解。" FontSize="25" FontWeight="SemiBold" LineHeight="31"/><StackPanel x:Name="WordTools" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0"/></Grid>
     <TextBlock x:Name="Phonetic" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/>
     <Border x:Name="Editor" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="8" Margin="0,0,0,10" Visibility="Collapsed"><StackPanel><TextBox x:Name="Input" AcceptsReturn="True" MaxLength="2000" Height="66" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button x:Name="Submit" Content="翻译  ↵" HorizontalAlignment="Right" Padding="14,6" Background="{DynamicResource PanelBrush}"/></StackPanel></Border>
     <StackPanel x:Name="TranslationSection" Margin="0,0,0,13"><TextBlock x:Name="Translation" Text="选中一段文字，翻译会自动浮现。" FontSize="20" FontWeight="Medium" LineHeight="28"/></StackPanel>
     <Border x:Name="DetailsSection" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,11,0,0" Margin="0,0,0,11"><StackPanel><TextBlock x:Name="DetailsCaption" Text="释义" Style="{StaticResource Caption}"/><TextBlock x:Name="Details" LineHeight="20"/></StackPanel></Border>
     <StackPanel x:Name="ExamplesSection" Margin="0,0,0,10"><TextBlock x:Name="ExamplesCaption" Text="例句" Style="{StaticResource Caption}"/><Border x:Name="ExampleSurface" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10"><TextBlock x:Name="Examples" LineHeight="21"/></Border></StackPanel>
     <StackPanel x:Name="StructureSection" Margin="0,0,0,10"><TextBlock x:Name="StructureCaption" Text="句式与搭配" Style="{StaticResource Caption}"/><TextBlock x:Name="Structure" Foreground="{DynamicResource AccentBrush}" LineHeight="20"/></StackPanel>
     <TextBlock x:Name="Notice" Text="点击右上角，自定义你的学习卡片。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,1,0,10"/>
    </StackPanel>
    <StackPanel x:Name="Preferences" Visibility="Collapsed">
     <TextBlock x:Name="PreferencesTitle" Text="你的卡片，你来定义。" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="内容与外观实时生效" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>
     <Border CornerRadius="12" Background="{DynamicResource PanelBrush}" Padding="12,7" Margin="0,0,0,14"><StackPanel><CheckBox x:Name="StartupOption" Content="开机启动"/><TextBlock x:Name="StartupHint" Text="登录 Windows 后自动运行，静默驻留托盘。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3,0,4"/></StackPanel></Border>
     <TextBlock Text="卡片主题" Style="{StaticResource Caption}"/><WrapPanel x:Name="ThemeGallery" Margin="0,0,0,12"/><TextBlock Text="主题切换立即生效，下次启动自动保留。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>
     <Border CornerRadius="12" Background="{DynamicResource PanelBrush}" Padding="12" Margin="0,0,0,14"><StackPanel>
      <TextBlock Text="翻译服务" Style="{StaticResource Caption}"/><ComboBox x:Name="Service" Margin="0,0,0,10"/>
      <StackPanel x:Name="PresetSection"><TextBlock Text="模型分类" Style="{StaticResource Caption}"/><ComboBox x:Name="ModelPreset" Margin="0,0,0,10"/></StackPanel>
      <StackPanel x:Name="CustomSection" Visibility="Collapsed"><TextBlock Text="HTTPS 完整接口地址" FontSize="11"/><TextBox x:Name="Endpoint"/><TextBlock Text="模型名称" FontSize="11"/><TextBox x:Name="Model"/></StackPanel>
      <StackPanel x:Name="KeySection"><TextBlock Text="API Key" Style="{StaticResource Caption}"/><PasswordBox x:Name="ApiKey" Padding="8,8" Margin="0,0,0,8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"/></StackPanel>
      <TextBlock x:Name="ServiceHint" Text="选择服务和模型，只需填写 Key。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="SaveService" Content="保存并使用" Padding="12,8" Background="{DynamicResource PanelBrush}"/><Button x:Name="TestService" Grid.Column="1" Content="测试连接" Padding="12,8" Margin="5,0,0,0" ToolTip="使用 hello 进行一次模型测试调用"/></Grid>
      <TextBlock x:Name="ServiceStatus" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/>
     </StackPanel></Border>
     <Border CornerRadius="12" Background="{DynamicResource PanelBrush}" Padding="12,8"><StackPanel x:Name="ModuleOptions"/></Border>
     <CheckBox x:Name="CompactOption" Content="紧凑排版" Margin="0,12,0,7"/>
     <TextBlock Text="玻璃浓度" Style="{StaticResource Caption}" Margin="0,8,0,5"/><Slider x:Name="Tint" Minimum="70" Maximum="240" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>
     <CheckBox x:Name="AutomaticOption" Content="划词后自动翻译"/><TextBlock Text="启用时，选中的文本会直接发送到翻译服务。" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,12"/>
     <TextBlock Text="目标语言" Style="{StaticResource Caption}"/><ComboBox x:Name="Language" Margin="0,0,0,12"/>
     <TextBlock Text="朗读声音" Style="{StaticResource Caption}"/><ComboBox x:Name="Voice" Margin="0,0,0,12"/>
     <Expander Header="排除应用" FontSize="12" Margin="0,5,0,10"><StackPanel Margin="0,12,0,0">
      <TextBlock Text="排除应用 · 逗号分隔进程名" FontSize="11"/><TextBox x:Name="Excluded"/>
      <Button x:Name="SaveExcluded" Content="保存排除应用" Padding="12,8" Background="{DynamicResource PanelBrush}"/>
     </StackPanel></Expander>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="就绪" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/><TextBlock x:Name="LanguageLabel" Grid.Column="1" Text="EN → 中文" Foreground="{DynamicResource Muted}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid>
 </StackPanel>
</Border>
